# ── Service ──────────────────────────────────────────────────────────────────
SERVICE_NAME=tm-agentic-ingestion-service
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── AWS Parameter Store (SOURCE OF TRUTH FOR SECRETS IN PROD) ────────────────
# When USE_PARAMETER_STORE=true, the keys below are READ from SSM at startup
# via the names given in *_PARAM. Local .env values act as dev overrides only.
USE_PARAMETER_STORE=false
AWS_REGION=us-east-1

PG_DSN_PARAM=/charter/rag/ingestion/PG_DSN
NVIDIA_API_KEY_PARAM=/charter/rag/ingestion/NVIDIA_API_KEY

# ── Local dev overrides (ignored when USE_PARAMETER_STORE=true & SSM resolves)
PG_DSN=postgresql+psycopg://rag:rag@localhost:5432/rag
NVIDIA_API_KEY=

# ── PostgreSQL pool ──────────────────────────────────────────────────────────
PG_POOL_SIZE=10
PG_POOL_MAX_OVERFLOW=10

# ── S3 ───────────────────────────────────────────────────────────────────────
# Layout: s3://${S3_BUCKET}/raw/{maintenance|construction|businessintelligence}/{documents|images}/...
S3_BUCKET=rag-496359311344-us-east-1-an

# ── NVIDIA NIM ───────────────────────────────────────────────────────────────
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VLM_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
EMBED_DIM=1536
EMBED_BATCH_SIZE=16
VLM_MAX_IMAGE_PX=1024
VLM_TIMEOUT_SECONDS=120
EMBED_TIMEOUT_SECONDS=60

# ── Pipeline ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=1.0
RETRY_BACKOFF_CAP_SECONDS=30.0

# ── Circuit Breakers (per spec: fail_max=3, reset_timeout=60) ────────────────
CB_VLM_FAIL_MAX=3
CB_VLM_RESET_TIMEOUT=60
CB_EMBED_FAIL_MAX=3
CB_EMBED_RESET_TIMEOUT=60
